# Copy to /etc/default/dms on the Jetson (systemd already loads this file).
# Do not commit real passwords.
DMS_DEVICE_ID=orin-nano-01
DMS_MQTT_USERNAME=dms-orin
DMS_MQTT_PASSWORD=replace-me
# Bench broker. Leave the port on 1883 and TLS off.
DMS_MQTT_PORT=1883
DMS_MQTT_TLS=0
# Production broker:
# DMS_MQTT_PORT=8883
# DMS_MQTT_TLS=1
# Production only. Leave unset on a bench that still uses dev-media-key.
# DMS_REQUIRE_DEVICE_KEY=1
# DMS_MEDIA_DEVICE_KEY=replace-with-the-vehicle-key
