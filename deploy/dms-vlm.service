# Local VLM server (llama.cpp) for the DMS. Install:
#   sudo cp deploy/*.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now dms-vlm dms
[Unit]
Description=DMS cabin VLM server (llama.cpp)
After=network.target

[Service]
Type=simple
User=dms
WorkingDirectory=/opt/dms
ExecStart=/opt/dms/tools/vlm_server.sh
Restart=always
RestartSec=5
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target
