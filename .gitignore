# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Device-local config and secrets. Other Jetsons copy the example files.
config/dms.yaml
.env
.env.*
!.env.example
!**/.env.example
deploy/**/.env
*.pem
*.key

# Runtime data. Source of truth is config/ plus tools/enroll_driver.py.
data/*
*.log
*.lock
*.sqlite
*.sqlite3
*.sqlite3-*

# Models and engines are downloaded or built on each Jetson.
models/*
!models/README.md
third_party/

# Local camera recordings used as stand-in sources.
videos/
*.mp4
*.avi
*.mov
*.mkv

# Not needed to run DMS on another device (stay on this machine / the VPS).
cloud/
tests/
docs/
assets/
deploy/vps/
deploy/emqx/

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Archives and local copies
*.zip
