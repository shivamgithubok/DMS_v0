# Local / Render environment for the guardian API.
# MQTT_* is the VPS broker. DATABASE_URL is Render Postgres in production.

MQTT_HOST=REPLACE_WITH_VPS_IP
MQTT_PORT=1883
MQTT_USERNAME=dms-cloud
MQTT_PASSWORD=replace-me
MQTT_TLS=false

DATABASE_URL=sqlite:///./data.db
DEFAULT_RIDE_ID=ride-1842
DEFAULT_DEVICE_ID=orin-nano-01
DEFAULT_PASSENGER=Meera Shah

# Local desk. Leave auth off so the current phone build keeps working.
# Production sets GUARDIAN_AUTH_REQUIRED=1, GUARDIAN_REQUIRE_DEVICE_KEY=1, SEED_DEMO=0.
GUARDIAN_AUTH_REQUIRED=0
GUARDIAN_REQUIRE_DEVICE_KEY=0
SEED_DEMO=1
GUARDIAN_API_KEY=
GUARDIAN_SESSION_SECRET=
CORS_ORIGINS=

# LiveKit on the VPS. dummy://local = JPEG preview path (no SFU).
LIVEKIT_URL=dummy://local
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-please-32b
MEDIA_DEVICE_KEY=dev-media-key
